pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/helber-fa/hillel_05_25_2026.git'
            }
        }
        stage('Install venv') {
            steps {
                sh '''apt-get update
                    apt-get install -y python3 python3-dev
                    apt install -y python3-pip
                    rm -rf venv
                    apt install -y python3.13-venv
                    python3 -m venv venv'''
            }
        }
        stage('Install requirements') {
            steps {
                sh '''#!/bin/bash
                    source venv/bin/activate
                    pip install -r requirements.txt'''
            }
        }
        stage('Run tests') {
            steps {
                sh '''#!/bin/bash
                    source venv/bin/activate
                    pytest -m swapi --alluredir=allure-results'''
            }
        }
    }

    post {
        always {
            allure commandline: 'Allure', includeProperties: false, jdk: '', resultPolicy: 'LEAVE_AS_IS', results: [[path: 'allure-results']]
        }
    }
}